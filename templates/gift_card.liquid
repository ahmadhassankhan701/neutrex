{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ gift_card.balance | money }} {{ gift_card.customer.name | default: shop.name }} — {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
    <style>
      .gift-card {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--space-6);
        background: var(--gradient-hero);
        color: #fff;
        text-align: center;
      }
      .gift-card__card {
        width: min(100%, 28rem);
        padding: var(--space-7);
        border-radius: var(--radius-2xl);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        backdrop-filter: blur(18px);
        box-shadow: var(--shadow-lg);
        color: var(--color-text);
      }
      .gift-card__logo {
        margin: 0 auto var(--space-5);
        max-width: 8rem;
      }
      .gift-card__amount {
        font-size: var(--fs-3xl);
        font-weight: 700;
        color: var(--color-gold);
        margin-bottom: var(--space-2);
      }
      .gift-card__code {
        font-family: ui-monospace, monospace;
        letter-spacing: 0.12em;
        font-size: var(--fs-lg);
        margin: var(--space-5) 0;
        padding: var(--space-4);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        border: 1px dashed var(--color-border);
      }
      .gift-card__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        justify-content: center;
        margin-top: var(--space-6);
      }
      @media print {
        .gift-card { background: #fff; color: #000; }
        .gift-card__actions { display: none; }
      }
    </style>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>
  <body>
    <div class="gift-card">
      <div class="gift-card__card">
        {%- if settings.logo != blank -%}
          <img
            class="gift-card__logo"
            src="{{ settings.logo | image_url: width: 280 }}"
            alt="{{ shop.name | escape }}"
            width="140"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <p style="font-weight:700;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:1.5rem;">
            {{ settings.brand_name | default: shop.name }}
          </p>
        {%- endif -%}

        <p class="gift-card__amount">{{ gift_card.balance | money }}</p>
        <p style="color:var(--color-text-muted);">{{ shop.name }} gift card</p>

        {%- unless gift_card.enabled -%}
          <p style="color:var(--color-error);margin-top:1rem;">This gift card has been disabled.</p>
        {%- endunless -%}
        {%- if gift_card.expired -%}
          <p style="color:var(--color-error);margin-top:1rem;">This gift card expired on {{ gift_card.expires_on | date: format: 'date' }}.</p>
        {%- endif -%}

        <div class="gift-card__code" id="GiftCardDigits">{{ gift_card.code | format_code }}</div>

        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="btn btn--secondary btn--sm">Add to Apple Wallet</a>
        {%- endif -%}

        <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>

        <div class="gift-card__actions">
          <button type="button" class="btn btn--primary" onclick="window.print();">Print</button>
          <a href="{{ shop.url }}" class="btn btn--secondary">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('QrCode');
        if (el && typeof QRCode !== 'undefined') {
          new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
        }
      });
    </script>
  </body>
</html>
