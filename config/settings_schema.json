  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "range",
        "id": "font_scale",
        "min": 90,
        "max": 110,
        "step": 1,
        "unit": "%",
        "label": "t:settings_schema.typography.font_scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_weight",
        "min": 600,
        "max": 800,
        "step": 100,
        "label": "t:settings_schema.typography.heading_weight",
        "default": 700
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "t:settings_schema.layout.page_width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 40,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:settings_schema.layout.section_spacing",
        "default": 80
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:settings_schema.layout.border_radius",
        "default": 16
      }
    ]
  },
  {
    "name": "t:settings_schema.header.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "t:settings_schema.header.sticky",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_transparent",
        "label": "t:settings_schema.header.transparent",
        "default": true
      },
      {
        "type": "link_list",
        "id": "menu",
        "label": "t:settings_schema.header.menu",
        "default": "main-menu"
      },
      {
        "type": "checkbox",
        "id": "enable_mega_menu",
        "label": "t:settings_schema.header.mega_menu",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_book_cta",
        "label": "t:settings_schema.header.show_book_cta",
        "default": true
      },
      {
        "type": "text",
        "id": "book_cta_label",
        "label": "t:settings_schema.header.book_cta_label",
        "default": "Book Training"
      },
      {
        "type": "url",
        "id": "book_cta_link",
        "label": "t:settings_schema.header.book_cta_link",
        "info": "Defaults to the تدريب collection when left blank"
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings_schema.cart.type",
        "options": [
          { "value": "drawer", "label": "t:settings_schema.cart.drawer" },
          { "value": "page", "label": "t:settings_schema.cart.page" }
