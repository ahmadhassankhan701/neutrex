[
  {
    "name": "theme_info",
    "theme_name": "Neutrex",
    "theme_version": "1.0.0",
    "theme_author": "Neutrex Studio",
    "theme_documentation_url": "https://neutrex.fit",
    "theme_support_url": "https://neutrex.fit/support"
  },
  {
    "name": "t:settings_schema.brand.name",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "t:settings_schema.brand.brand_name",
        "default": "Neutrex"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.brand.logo"
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "t:settings_schema.brand.logo_dark"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.brand.favicon"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "label": "t:settings_schema.brand.logo_width",
        "default": 140
      }
    ]
  },
