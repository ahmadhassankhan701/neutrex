<!doctype html>
{%- liquid
  assign is_rtl = false
  if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' or request.locale.iso_code contains 'ar-'
    assign is_rtl = true
  endif
-%}
<html
  lang="{{ request.locale.iso_code }}"
  dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}"
  class="no-js template-password"
  data-color-scheme-default="{{ settings.color_scheme_default }}"
  data-animations="false"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

    <script>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('neutrex-theme');
        } catch (e) {}
        var def = document.documentElement.dataset.colorSchemeDefault || 'system';
        var pref = stored || def;
        var dark =
          pref === 'dark' ||
          (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>

    <title>{{ shop.name | escape }}</title>

    {%- render 'css-variables' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'layout.css' | asset_url | stylesheet_tag }}
    {{ 'account.css' | asset_url | stylesheet_tag }}

    <style>
      .password-page {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-6) var(--page-gutter);
        background: var(--gradient-hero);
      }
      .password-page__inner {
        width: min(100%, 28rem);
        padding: var(--space-7);
        border-radius: var(--radius-xl);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--shadow-lg);
        color: var(--color-text);
      }
      .password-page__logo img {
        width: {{ settings.logo_width }}px;
        height: auto;
        margin-inline: auto;
      }
      .password-page__heading {
        font-size: var(--fs-2xl);
        font-weight: var(--heading-weight);
        margin-block-end: var(--space-3);
        text-align: center;
      }
      .password-page__message {
        color: var(--color-text-muted);
        margin-block-end: var(--space-5);
        text-align: center;
      }
      .password-page__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      .password-page__footer {
        margin-block-start: var(--space-6);
        font-size: var(--fs-sm);
        color: var(--color-text-muted);
        text-align: center;
      }
      .password-page__footer a {
        color: var(--color-primary);
      }
    </style>

    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
