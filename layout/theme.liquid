<!doctype html>
{%- liquid
  assign is_rtl = false
  if request.locale.iso_code == 'ar' or request.locale.root_url contains '/ar' or request.locale.iso_code contains 'ar-'
    assign is_rtl = true
  endif

  assign load_product_assets = false
  assign load_collection_assets = false
  assign load_appointments_assets = false
  assign load_account_assets = false

  case template.name
    when 'product'
      assign load_product_assets = true
      assign load_collection_assets = true
    when 'collection', 'search', 'list-collections', 'index'
      assign load_collection_assets = true
  endcase

  if template.name == 'page'
    if template.suffix == 'appointment' or template.suffix == 'coach' or template.suffix == 'account-appointments'
      assign load_appointments_assets = true
    endif
    if template.suffix == 'wishlist' or template.suffix == 'contact' or template.suffix == 'account-appointments'
      assign load_account_assets = true
    endif
  endif

  if template.directory == 'customers'
    assign load_account_assets = true
  endif

  assign main_menu = linklists[settings.menu]
  if main_menu == blank
    assign main_menu = linklists['main-menu']
  endif
  assign logo_width = settings.logo_width | default: 140
  assign is_transparent = false
  if settings.header_transparent and template.name == 'index'
    assign is_transparent = true
  endif
  assign book_label = settings.book_cta_label
  if book_label == blank
    assign book_label = 'Book Training'
  endif
  assign book_link = settings.book_cta_link
  if book_link == blank
    assign book_link = settings.booking_form_url
  endif
  if book_link == blank
    assign book_link = '/pages/personal-training'
  endif
-%}
<html
  lang="{{ request.locale.iso_code }}"
  dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}"
  class="no-js"
  data-color-scheme-default="{{ settings.color_scheme_default }}"
  data-animations="{% if settings.enable_animations %}true{% else %}false{% endif %}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">

    <script>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('neutrex-theme'); } catch (e) {}
        var def = document.documentElement.dataset.colorSchemeDefault || 'system';
        var pref = stored || def;
        var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- render 'meta-tags' -%}
    {%- render 'css-variables' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'layout.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}

    {%- if load_product_assets -%}{{ 'product.css' | asset_url | stylesheet_tag }}{%- endif -%}
    {%- if load_collection_assets -%}{{ 'collection.css' | asset_url | stylesheet_tag }}{%- endif -%}
    {%- if load_appointments_assets -%}{{ 'appointments.css' | asset_url | stylesheet_tag }}{%- endif -%}
    {%- if load_account_assets -%}{{ 'account.css' | asset_url | stylesheet_tag }}{%- endif -%}

    {%- render 'schema-organization' -%}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>

  <body
    class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}"
    {% if is_rtl %}data-locale-rtl="true"{% endif %}
  >
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- section 'announcement-bar' -%}

    {%- comment -%} Header inlined so Shopify Git sync cannot miss a separate header file {%- endcomment -%}
    <div
      class="site-header{% if is_transparent %} site-header--transparent{% endif %}{% unless settings.header_sticky %} site-header--static{% endunless %}"
      data-site-header
      role="banner"
    >
      <div class="site-header__inner page-width">
        <button
          type="button"
          class="site-header__icon-btn site-header__menu-toggle"
          data-mobile-nav-open
          aria-expanded="false"
          aria-controls="MobileNav"
          aria-label="Menu"
        >
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>

        <a href="{{ routes.root_url }}" class="site-header__logo">
          {%- if settings.logo != blank -%}
            <img
              class="site-header__logo-img site-header__logo-img--light"
              src="{{ settings.logo | image_url: width: logo_width }}"
              alt="{{ shop.name | escape }}"
              width="{{ logo_width }}"
              loading="eager"
            >
          {%- endif -%}
          {%- if settings.logo_dark != blank -%}
            <img
              class="site-header__logo-img site-header__logo-img--dark"
              src="{{ settings.logo_dark | image_url: width: logo_width }}"
              alt="{{ shop.name | escape }}"
              width="{{ logo_width }}"
              loading="eager"
            >
          {%- endif -%}
          {%- if settings.logo == blank and settings.logo_dark == blank -%}
            <span>{{ settings.brand_name | default: shop.name | escape }}</span>
          {%- endif -%}
        </a>

        {%- if main_menu != blank and main_menu.links.size > 0 -%}
          <nav class="site-nav" aria-label="Menu">
            <ul class="site-nav__list" role="list">
              {%- for link in main_menu.links -%}
                <li class="site-nav__item">
                  {%- if link.links.size > 0 -%}
                    <details class="site-nav__details">
                      <summary class="site-nav__link">{{ link.title | escape }}</summary>
                      <ul class="site-nav__dropdown" role="list">
                        {%- for child in link.links -%}
                          <li><a href="{{ child.url }}" class="mega-menu__link">{{ child.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- else -%}
                    <a href="{{ link.url }}" class="site-nav__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <div class="site-header__actions">
          {%- if settings.show_book_cta -%}
            <a href="{{ book_link }}" class="btn btn--primary btn--sm site-header__cta hide-mobile">{{ book_label | escape }}</a>
          {%- endif -%}

          <button type="button" class="site-header__icon-btn" data-predictive-search-open aria-label="Search">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          </button>

          {% render 'language-switcher' %}

          {%- if settings.enable_wishlist -%}
            <a
              href="/pages/wishlist"
              class="site-header__icon-btn hide-mobile"
              aria-label="{{ 'header.wishlist' | t }}"
              data-wishlist-link
            >
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 20.5s-7-4.6-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10.5c0 5.4-7 10-7 10z"/></svg>
              <span class="site-header__cart-count site-header__wishlist-count" data-wishlist-count aria-hidden="true">0</span>
            </a>
          {%- endif -%}

          <div class="hide-mobile">{% render 'theme-switcher' %}</div>

          <button type="button" class="site-header__icon-btn" data-cart-open aria-label="Cart">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6h15l-1.5 9H7.5L6 6z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
            <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
          </button>
        </div>
      </div>

      <div class="mobile-nav" id="MobileNav" data-mobile-nav hidden>
        <div class="mobile-nav__overlay" data-mobile-nav-close tabindex="-1"></div>
        <div class="mobile-nav__panel" role="dialog" aria-modal="true" aria-label="Menu">
          <div class="mobile-nav__header">
            <p class="mobile-nav__title">Menu</p>
            <button type="button" class="site-header__icon-btn" data-mobile-nav-close aria-label="Close">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>

          {%- if main_menu != blank and main_menu.links.size > 0 -%}
            <nav class="mobile-nav__nav" aria-label="Menu">
              <ul class="mobile-nav__list" role="list">
                {%- for link in main_menu.links -%}
                  <li class="mobile-nav__item">
                    {%- if link.links.size > 0 -%}
                      <details class="mobile-nav__details">
                        <summary class="mobile-nav__link"><span>{{ link.title | escape }}</span></summary>
                        <ul class="mobile-nav__sublist" role="list">
                          {%- for child in link.links -%}
                            <li><a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- else -%}
                      <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title | escape }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}

          <div class="mobile-nav__footer">
            {%- if settings.show_book_cta -%}
              <a href="{{ book_link }}" class="btn btn--primary btn--full">{{ book_label | escape }}</a>
            {%- endif -%}
            <div class="mobile-nav__footer-links">
              <a href="{{ routes.account_url }}" class="mobile-nav__footer-link">Account</a>
              {%- if settings.enable_wishlist -%}
                <a href="/pages/wishlist" class="mobile-nav__footer-link">Wishlist</a>
              {%- endif -%}
            </div>
            <div class="mobile-nav__switchers">
              {% render 'theme-switcher' %}
              {% render 'language-switcher' %}
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function () {
        var el = document.querySelector('[data-site-header]');
        if (!el) return;
        var onScroll = function () { el.classList.toggle('is-scrolled', window.scrollY > 24); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- section 'footer' -%}
    {%- section 'cart-drawer' -%}
    {%- render 'quick-view-modal' -%}
    {%- section 'predictive-search' -%}
    {%- section 'whatsapp-float' -%}

    <script>
      window.theme = window.theme || {};
      window.theme.moneyFormat = {{ shop.money_format | json }};
      window.Shopify = window.Shopify || {};
      if (!window.Shopify.formatMoney) {
        window.Shopify.formatMoney = function (cents, format) {
          if (typeof cents === 'string') cents = cents.replace('.', '');
          var value = (parseFloat(cents || 0) / 100).toFixed(2);
          var placeholder = /\{\{\s*(\w+)\s*\}\}/;
          var fmt = format || window.theme.moneyFormat || '{{amount}}';
          function formatWithDelimiters(number, precision, thousands, decimal) {
            precision = precision == null ? 2 : precision;
            thousands = thousands || ',';
            decimal = decimal || '.';
            if (isNaN(number) || number == null) return '0';
            number = (number / 100).toFixed(precision);
            var parts = number.split('.');
            var dollars = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands);
            var centsPart = parts[1] ? decimal + parts[1] : '';
            return dollars + centsPart;
          }
          var match = fmt.match(placeholder);
          if (!match) return value;
          switch (match[1]) {
            case 'amount':
              value = formatWithDelimiters(cents, 2);
              break;
            case 'amount_no_decimals':
              value = formatWithDelimiters(cents, 0);
              break;
            case 'amount_with_comma_separator':
              value = formatWithDelimiters(cents, 2, '.', ',');
              break;
            case 'amount_no_decimals_with_comma_separator':
              value = formatWithDelimiters(cents, 0, '.', ',');
              break;
            default:
              value = formatWithDelimiters(cents, 2);
          }
          return fmt.replace(placeholder, value);
        };
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'animations.js' | asset_url }}" defer></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    {%- if load_product_assets -%}<script src="{{ 'product.js' | asset_url }}" defer></script>{%- endif -%}
    {%- if load_collection_assets -%}<script src="{{ 'collection.js' | asset_url }}" defer></script>{%- endif -%}
    {%- if load_appointments_assets -%}<script src="{{ 'appointments.js' | asset_url }}" defer></script>{%- endif -%}
  </body>
</html>
