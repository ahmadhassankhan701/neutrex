{%- comment -%}
  Language and country localization selectors.
  @param {string} [class] - Additional wrapper classes
{%- endcomment -%}

{%- if localization.available_languages.size > 1 or localization.available_countries.size > 1 -%}
  <div class="locale-selectors{% if class != blank %} {{ class }}{% endif %}">
    {%- form 'localization', class: 'locale-selectors__form' -%}
      {%- if localization.available_languages.size > 1 -%}
        <div class="locale-selectors__field">
          <label class="visually-hidden" for="LocaleSelector-Language">
            {{ 'header.language' | t }}
          </label>
          <div class="locale-selectors__select-wrap">
            {%- render 'icon', icon: 'globe', size: 'sm' -%}
            <select
              id="LocaleSelector-Language"
              class="locale-selectors__select"
              name="locale_code"
              aria-label="{{ 'header.language' | t }}"
              onchange="this.form.submit()"
            >
              {%- for language in localization.available_languages -%}
                <option
                  value="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                >
                  {{ language.endonym_name | capitalize }}
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', icon: 'chevron-down', size: 'sm', class: 'locale-selectors__chevron' -%}
          </div>
        </div>
      {%- endif -%}

      {%- if localization.available_countries.size > 1 -%}
        <div class="locale-selectors__field">
          <label class="visually-hidden" for="LocaleSelector-Country">
            {{ 'localization.country_label' | t }}
          </label>
          <div class="locale-selectors__select-wrap">
            <select
              id="LocaleSelector-Country"
              class="locale-selectors__select"
              name="country_code"
              aria-label="{{ 'localization.country_label' | t }}"
              onchange="this.form.submit()"
            >
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', icon: 'chevron-down', size: 'sm', class: 'locale-selectors__chevron' -%}
          </div>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}
