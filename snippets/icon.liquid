{%- comment -%}
  Renders an inline SVG icon.
  @param {string} icon - Icon name
  @param {string} [class] - Additional CSS classes
  @param {string} [size] - sm | lg (default base 1.25rem)
  @param {boolean} [decorative] - Default true (aria-hidden)
{%- endcomment -%}

{%- liquid
  assign icon_class = 'icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
  if size == 'sm'
    assign icon_class = icon_class | append: ' icon--sm'
  elsif size == 'lg'
    assign icon_class = icon_class | append: ' icon--lg'
  endif
  assign is_decorative = true
  if decorative == false
    assign is_decorative = false
  endif
-%}

<svg
  class="{{ icon_class }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  {% if is_decorative %}
    aria-hidden="true"
    focusable="false"
  {% else %}
    role="img"
  {% endif %}
>
  {%- case icon -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    {%- when 'cart', 'bag' -%}
      <path d="M6 6h15l-1.5 9H7.5L6 6z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 12.5-4 16 0"/>
    {%- when 'wishlist', 'heart' -%}
      <path d="M12 20.5s-7-4.6-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10.5c0 5.4-7 10-7 10z"/>
    {%- when 'heart-filled' -%}
      <path d="M12 20.5s-7-4.6-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10.5c0 5.4-7 10-7 10z" fill="currentColor" stroke="none"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="M5 12l5 5L20 7"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 16.8 7.2 18.4l.9-5.4L4.2 9.2l5.4-.8L12 3.5z"/>
    {%- when 'star-half' -%}
      <path d="M12 3.5l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 16.8V3.5z" fill="currentColor" stroke="none"/><path d="M12 3.5l-2.4 4.9-5.4.8 3.9 3.8-.9 5.4L12 16.8"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/>
    {%- when 'moon' -%}
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7 7 0 1 0 20 14.5z"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.8 4 6.2 4 9s-1.5 6.2-4 9M12 3c-2.5 2.8-4 6.2-4 9s1.5 6.2 4 9"/>
    {%- when 'share' -%}
      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.7l6.8-3.9M8.6 13.3l6.8 3.9"/>
    {%- when 'facebook' -%}
      <path d="M14 8h3V5h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1z"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    {%- when 'tiktok' -%}
      <path d="M9 18a4 4 0 1 1 0-8v-2a6 6 0 0 0 6 6v-4a8 8 0 0 0 5 3v-3a5 5 0 0 1-3-1.5V6h-3v8a2 2 0 1 1-2-2"/>
    {%- when 'youtube' -%}
      <path d="M3 8.5c0-1.5 1.2-2.7 2.7-2.7h12.6c1.5 0 2.7 1.2 2.7 2.7v7c0 1.5-1.2 2.7-2.7 2.7H5.7C4.2 18.2 3 17 3 15.5v-7z"/><path d="M10 9.5v5l4.5-2.5L10 9.5z" fill="currentColor" stroke="none"/>
    {%- when 'twitter' -%}
      <path d="M4 4l16 16M20 4L4 20"/>
    {%- when 'whatsapp' -%}
      <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3z"/><path d="M9.5 9.5c.3-.8 1-.8 1.3-.8h.3c.1 0 .3 0 .4.3l.6 1.4c.1.2 0 .4-.1.5l-.4.5c-.1.1-.1.3 0 .4.5.9 1.4 1.7 2.4 2.1.1.1.3 0 .4-.1l.5-.5c.1-.1.3-.1.5 0l1.4.6c.2.1.3.3.3.4v.3c0 .3-.1.9-.8 1.2-.6.3-1.4.4-2.1.2-1.1-.3-2.4-1-3.4-2.1-1-1-1.7-2.3-2-3.4-.2-.7-.1-1.5.2-2.1z"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'sort' -%}
      <path d="M8 4v16M8 20l-3-3M8 20l3-3M16 20V4M16 4l-3 3M16 4l3 3"/>
    {%- when 'play' -%}
      <path d="M8 5v14l11-7L8 5z" fill="currentColor" stroke="none"/>
    {%- when 'pause' -%}
      <path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" stroke="none"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v8H3z"/><path d="M14 10h4l2 3v2h-6"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z"/><circle cx="12" cy="11" r="2.5"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    {%- when 'phone' -%}
      <path d="M6.5 4h3l1.5 5-2 1.5c1.2 2.4 3.1 4.3 5.5 5.5L18 14l5 1.5v3A14 14 0 0 1 6.5 4z"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
