{%- comment -%}
  Accessible button / link component.
  @param {string} label - Button text
  @param {string} [url] - Link URL (renders <a> when set)
  @param {string} [style] - primary | secondary | gold | ghost
  @param {string} [size] - sm | lg
  @param {boolean} [full_width] - Full width modifier
  @param {boolean} [external] - Open in new tab
  @param {string} [type] - Button type (default submit for forms, button otherwise)
  @param {string} [class] - Extra classes
  @param {string} [name] - Button name attribute
  @param {string} [id] - Element id
  @param {boolean} [disabled] - Disabled state
{%- endcomment -%}

{%- liquid
  assign btn_style = style | default: 'primary'
  assign btn_class = 'btn btn--' | append: btn_style
  if size == 'sm'
    assign btn_class = btn_class | append: ' btn--sm'
  elsif size == 'lg'
    assign btn_class = btn_class | append: ' btn--lg'
  endif
  if full_width
    assign btn_class = btn_class | append: ' btn--full'
  endif
  if class != blank
    assign btn_class = btn_class | append: ' ' | append: class
  endif
-%}

{%- if url != blank -%}
  <a
    href="{{ url }}"
    class="{{ btn_class }}"
    {% if id != blank %}id="{{ id | escape }}"{% endif %}
    {% if external %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  >
    {{ label | escape }}
  </a>
{%- else -%}
  <button
    type="{{ type | default: 'button' }}"
    class="{{ btn_class }}"
    {% if id != blank %}id="{{ id | escape }}"{% endif %}
    {% if name != blank %}name="{{ name | escape }}"{% endif %}
    {% if disabled %}disabled aria-disabled="true"{% endif %}
  >
    {{ label | escape }}
  </button>
{%- endif -%}
