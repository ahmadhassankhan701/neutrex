{%- comment -%}
  Pagination for paginate objects.
  @param {paginate} paginate - Shopify paginate object
  @param {string} [class] - Additional wrapper classes
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav
    class="pagination{% if class != blank %} {{ class }}{% endif %}"
    role="navigation"
    aria-label="{{ 'general.pagination.label' | t }}"
  >
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li class="pagination__item">
          <a
            class="pagination__link pagination__link--prev"
            href="{{ paginate.previous.url }}"
            aria-label="{{ 'general.accessibility.previous' | t }}"
          >
            {%- render 'icon', icon: 'chevron-left' -%}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li class="pagination__item">
          {%- if part.is_link -%}
            <a
              class="pagination__link"
              href="{{ part.url }}"
              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
            >
              {{ part.title }}
            </a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span
                class="pagination__link pagination__link--current"
                aria-current="page"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                {{ part.title }}
              </span>
            {%- else -%}
              <span class="pagination__ellipsis" aria-hidden="true">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li class="pagination__item">
          <a
            class="pagination__link pagination__link--next"
            href="{{ paginate.next.url }}"
            aria-label="{{ 'general.accessibility.next' | t }}"
          >
            {%- render 'icon', icon: 'chevron-right' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
