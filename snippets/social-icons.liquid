{%- comment -%}
  Social media icon links from theme settings.
  @param {string} [class] - Additional wrapper classes
{%- endcomment -%}

{%- liquid
  assign has_social = false
  if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_twitter != blank or settings.social_facebook != blank
    assign has_social = true
  endif

  assign social_class = 'social-icons'
  if class != blank
    assign social_class = social_class | append: ' ' | append: class
  endif
-%}

{%- if has_social -%}
  <ul class="{{ social_class }}" role="list">
    {%- if settings.social_instagram != blank -%}
      <li>
        <a
          class="social-icons__link"
          href="{{ settings.social_instagram | escape }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.social.share_on' | t: platform: 'Instagram' }}"
        >
          {%- render 'icon', icon: 'instagram' -%}
        </a>
      </li>
    {%- endif -%}

    {%- if settings.social_tiktok != blank -%}
      <li>
        <a
          class="social-icons__link"
          href="{{ settings.social_tiktok | escape }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.social.share_on' | t: platform: 'TikTok' }}"
        >
          {%- render 'icon', icon: 'tiktok' -%}
        </a>
      </li>
    {%- endif -%}

    {%- if settings.social_youtube != blank -%}
      <li>
        <a
          class="social-icons__link"
          href="{{ settings.social_youtube | escape }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.social.share_on' | t: platform: 'YouTube' }}"
        >
          {%- render 'icon', icon: 'youtube' -%}
        </a>
      </li>
    {%- endif -%}

    {%- if settings.social_twitter != blank -%}
      <li>
        <a
          class="social-icons__link"
          href="{{ settings.social_twitter | escape }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.social.share_on' | t: platform: 'X' }}"
        >
          {%- render 'icon', icon: 'twitter' -%}
        </a>
      </li>
    {%- endif -%}

    {%- if settings.social_facebook != blank -%}
      <li>
        <a
          class="social-icons__link"
          href="{{ settings.social_facebook | escape }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.social.share_on' | t: platform: 'Facebook' }}"
        >
          {%- render 'icon', icon: 'facebook' -%}
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
