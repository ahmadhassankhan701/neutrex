{%- comment -%}
  Global site header (snippet — not a section, so it always loads).
  Configurable via Theme settings → Header.
{%- endcomment -%}

{%- liquid
  assign main_menu = linklists[settings.menu]
  assign logo_width = settings.logo_width | default: 140

  assign is_transparent = false
  if settings.header_transparent and template.name == 'index'
    assign is_transparent = true
  endif

  assign book_label = settings.book_cta_label
  if book_label == blank
    assign book_label = 'header.book_training' | t
  endif

  assign book_link = settings.book_cta_link
  if book_link == blank
    assign book_link = settings.booking_form_url
  endif
  if book_link == blank
    assign book_link = '/pages/personal-training'
  endif
-%}

<div
  class="site-header{% if is_transparent %} site-header--transparent{% endif %}{% unless settings.header_sticky %} site-header--static{% endif %}"
  data-site-header
  role="banner"
>
  <div class="site-header__inner page-width">
    <button
      type="button"
      class="site-header__icon-btn site-header__menu-toggle"
      data-mobile-nav-open
      aria-expanded="false"
      aria-controls="MobileNav"
      aria-label="{{ 'general.accessibility.menu' | t }}"
    >
      {% render 'icon', icon: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        <img
          class="site-header__logo-img site-header__logo-img--light"
          src="{{ settings.logo | image_url: width: logo_width }}"
          alt="{{ shop.name | escape }}"
          width="{{ logo_width }}"
          loading="eager"
        >
      {%- endif -%}
      {%- if settings.logo_dark != blank -%}
        <img
          class="site-header__logo-img site-header__logo-img--dark"
          src="{{ settings.logo_dark | image_url: width: logo_width }}"
          alt="{{ shop.name | escape }}"
          width="{{ logo_width }}"
          loading="eager"
        >
      {%- endif -%}
      {%- if settings.logo == blank and settings.logo_dark == blank -%}
        <span>{{ settings.brand_name | default: shop.name | escape }}</span>
      {%- endif -%}
    </a>

    {%- if main_menu != blank and main_menu.links.size > 0 -%}
      <nav class="site-nav hide-mobile" aria-label="{{ 'header.menu' | t }}">
        <ul class="site-nav__list" role="list">
          {%- for link in main_menu.links -%}
            <li class="site-nav__item{% if link.links.size > 0 %} site-nav__item--has-dropdown{% endif %}">
              {%- if link.links.size > 0 -%}
                <details class="site-nav__details">
                  <summary class="site-nav__link">
                    {{ link.title | escape }}
                    {% render 'icon', icon: 'chevron-down', class: 'site-nav__chevron' %}
                  </summary>
                  <ul class="site-nav__dropdown" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a href="{{ child.url }}" class="mega-menu__link">{{ child.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="site-nav__link"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="site-header__actions">
      {%- if settings.show_book_cta -%}
        <a href="{{ book_link }}" class="btn btn--primary btn--sm site-header__cta hide-mobile">
          {{ book_label | escape }}
        </a>
      {%- endif -%}

      <button
        type="button"
        class="site-header__icon-btn"
        data-predictive-search-open
        aria-label="{{ 'general.accessibility.search' | t }}"
      >
        {% render 'icon', icon: 'search' %}
      </button>

      <a
        href="{{ routes.account_url }}"
        class="site-header__icon-btn hide-mobile"
        aria-label="{{ 'header.account' | t }}"
      >
        {% render 'icon', icon: 'account' %}
      </a>

      {%- if settings.enable_wishlist -%}
        <a
          href="/pages/wishlist"
          class="site-header__icon-btn hide-mobile"
          aria-label="{{ 'header.wishlist' | t }}"
        >
          {% render 'icon', icon: 'heart' %}
        </a>
      {%- endif -%}

      <div class="hide-mobile">{% render 'theme-switcher' %}</div>
      <div class="hide-mobile">{% render 'locale-selectors' %}</div>

      <button
        type="button"
        class="site-header__icon-btn"
        data-cart-open
        aria-label="{{ 'header.cart' | t }}"
      >
        {% render 'icon', icon: 'cart' %}
        {% render 'cart-count' %}
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="MobileNav" data-mobile-nav hidden>
    <div class="mobile-nav__overlay" data-mobile-nav-close tabindex="-1"></div>
    <div
      class="mobile-nav__panel"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'header.menu' | t }}"
    >
      <div class="mobile-nav__header">
        <p class="mobile-nav__title">{{ 'header.menu' | t }}</p>
        <button
          type="button"
          class="site-header__icon-btn"
          data-mobile-nav-close
          aria-label="{{ 'general.accessibility.close' | t }}"
        >
          {% render 'icon', icon: 'close' %}
        </button>
      </div>

      {%- if main_menu != blank and main_menu.links.size > 0 -%}
        <nav class="mobile-nav__nav" aria-label="{{ 'header.menu' | t }}">
          <ul class="mobile-nav__list" role="list">
            {%- for link in main_menu.links -%}
              <li class="mobile-nav__item">
                {%- if link.links.size > 0 -%}
                  <details class="mobile-nav__details">
                    <summary class="mobile-nav__link">
                      <span>{{ link.title | escape }}</span>
                      {% render 'icon', icon: 'chevron-down' %}
                    </summary>
                    <ul class="mobile-nav__sublist" role="list">
                      {%- for child in link.links -%}
                        <li>
                          <a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="mobile-nav__footer">
        {%- if settings.show_book_cta -%}
          <a href="{{ book_link }}" class="btn btn--primary btn--full">{{ book_label | escape }}</a>
        {%- endif -%}
        <div class="mobile-nav__footer-links">
          <a href="{{ routes.account_url }}" class="mobile-nav__footer-link">
            {% render 'icon', icon: 'account' %}
            {{ 'header.account' | t }}
          </a>
          {%- if settings.enable_wishlist -%}
            <a href="/pages/wishlist" class="mobile-nav__footer-link">
              {% render 'icon', icon: 'heart' %}
              {{ 'header.wishlist' | t }}
            </a>
          {%- endif -%}
        </div>
        <div class="mobile-nav__switchers">
          {% render 'theme-switcher' %}
          {% render 'locale-selectors' %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var el = document.querySelector('[data-site-header]');
    if (!el) return;
    var onScroll = function () {
      el.classList.toggle('is-scrolled', window.scrollY > 24);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
