{%- comment -%}
  Compact EN/AR language switcher for the header.
  Uses Shopify localization form when multiple languages are enabled.
{%- endcomment -%}

{%- liquid
  assign current_lang = localization.language.iso_code | default: request.locale.iso_code | downcase
  assign current_label = 'EN'
  if current_lang contains 'ar'
    assign current_label = 'ع'
  endif
-%}

{%- if localization.available_languages.size > 1 -%}
  <div class="language-switcher" data-language-switcher>
    {%- form 'localization', class: 'language-switcher__form' -%}
      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
      <button
        type="button"
        class="site-header__icon-btn language-switcher__toggle"
        data-language-toggle
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls="LanguageSwitcherMenu"
        aria-label="{{ 'header.language' | t }}: {{ localization.language.endonym_name | escape }}"
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18M12 3c2.5 2.8 4 6.2 4 9s-1.5 6.2-4 9M12 3c-2.5 2.8-4 6.2-4 9s1.5 6.2 4 9"/>
        </svg>
        <span class="language-switcher__code" aria-hidden="true">{{ current_label }}</span>
      </button>

      <ul
        id="LanguageSwitcherMenu"
        class="language-switcher__menu"
        role="listbox"
        aria-label="{{ 'header.language' | t }}"
        hidden
      >
        {%- for language in localization.available_languages -%}
          {%- liquid
            assign lang_code = language.iso_code | downcase
            assign short_label = language.iso_code | upcase | slice: 0, 2
            if lang_code contains 'ar'
              assign short_label = 'AR'
            elsif lang_code contains 'en'
              assign short_label = 'EN'
            endif
            assign is_current = false
            if language.iso_code == localization.language.iso_code
              assign is_current = true
            endif
          -%}
          <li role="option" aria-selected="{% if is_current %}true{% else %}false{% endif %}">
            <button
              type="submit"
              class="language-switcher__option{% if is_current %} is-active{% endif %}"
              name="locale_code"
              value="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
              {% if is_current %}aria-current="true"{% endif %}
            >
              <span class="language-switcher__option-code">{{ short_label }}</span>
              <span class="language-switcher__option-name">{{ language.endonym_name | capitalize }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endform -%}
  </div>
{%- else -%}
  {%- comment -%} Fallback when only one store language is published {%- endcomment -%}
  <div class="language-switcher language-switcher--single" title="Add English and Arabic in Settings → Languages">
    <span class="site-header__icon-btn language-switcher__toggle" aria-hidden="true">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <circle cx="12" cy="12" r="9"/>
        <path d="M3 12h18M12 3c2.5 2.8 4 6.2 4 9s-1.5 6.2-4 9M12 3c-2.5 2.8-4 6.2-4 9s1.5 6.2 4 9"/>
      </svg>
      <span class="language-switcher__code">{{ current_label }}</span>
    </span>
  </div>
{%- endif -%}
