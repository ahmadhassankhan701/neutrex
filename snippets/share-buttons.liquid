{%- comment -%}
  Social share buttons.
  @param {string} [url] - Share URL (defaults to current page)
  @param {string} [title] - Share title
  @param {string} [class] - Additional wrapper classes
{%- endcomment -%}

{%- liquid
  assign share_url = url | default: canonical_url | default: request.origin
  assign share_title = title | default: page_title | default: shop.name
  assign share_class = 'share-buttons'
  if class != blank
    assign share_class = share_class | append: ' ' | append: class
  endif

  assign encoded_url = share_url | url_encode
  assign encoded_title = share_title | url_encode
-%}

<div class="{{ share_class }}" role="group" aria-label="{{ 'products.share' | t }}">
  <span class="share-buttons__label">{{ 'products.share' | t }}</span>

  <ul class="share-buttons__list" role="list">
    <li>
      <a
        class="share-buttons__link"
        href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.social.share_on' | t: platform: 'Facebook' }}"
      >
        {%- render 'icon', icon: 'facebook' -%}
      </a>
    </li>
    <li>
      <a
        class="share-buttons__link"
        href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ encoded_title }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.social.share_on' | t: platform: 'X' }}"
      >
        {%- render 'icon', icon: 'twitter' -%}
      </a>
    </li>
    <li>
      <a
        class="share-buttons__link"
        href="https://wa.me/?text={{ encoded_title }}%20{{ encoded_url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.social.share_on' | t: platform: 'WhatsApp' }}"
      >
        {%- render 'icon', icon: 'whatsapp' -%}
      </a>
    </li>
    <li>
      <button
        type="button"
        class="share-buttons__link share-buttons__copy"
        data-share-copy
        data-share-url="{{ share_url | escape }}"
        aria-label="{{ 'general.social.share' | t }}"
      >
        {%- render 'icon', icon: 'share' -%}
      </button>
    </li>
  </ul>
</div>
