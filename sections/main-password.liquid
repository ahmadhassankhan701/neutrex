<div class="password-page" {{ section.shopify_attributes }}>
  <div class="password-page__inner">
    <div class="password-page__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="auth__logo">{{ settings.brand_name | default: shop.name | escape }}</span>
      {%- endif -%}
    </div>

    <h1 class="password-page__heading{% if settings.logo != blank %} visually-hidden{% endif %}">
      {{ section.settings.heading | default: shop.name | escape }}
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {%- elsif section.settings.message != blank -%}
      <p class="password-page__message">{{ section.settings.message | escape }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <p class="auth__error" role="alert">{{ form.errors.messages.password }}</p>
      {%- endif -%}

      <label class="visually-hidden" for="Password">{{ 'customer.login.password' | t }}</label>
      <input
        type="password"
        name="password"
        id="Password"
        class="password-page__input field__input"
        placeholder="{{ 'customer.login.password' | t }}"
        autocomplete="current-password"
        required
      >

      {%- liquid
        assign enter_label = section.settings.button_label | default: 'Enter store'
      -%}
      {%- render 'button', label: enter_label, style: 'primary', full_width: true, type: 'submit' -%}
    {%- endform -%}

    {%- if section.settings.show_login_link -%}
      <p class="password-page__footer">
        {{ 'customer.login.title' | t }}
        <a href="{{ routes.account_login_url }}">{{ 'account.login' | t }}</a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message override"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter store"
    },
    {
      "type": "checkbox",
      "id": "show_login_link",
      "label": "Show login link",
      "default": true
    }
  ]
}
{% endschema %}
