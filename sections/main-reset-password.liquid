<div class="auth" {{ section.shopify_attributes }}>
  <div class="auth__panel">
    <h1 class="auth__title">{{ 'customer.recover.title' | t }}</h1>
    <p class="auth__subtitle">{{ section.settings.subtitle | default: 'Enter a new password for your account.' | escape }}</p>

    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}
        <div class="auth__error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field field--password">
        <label class="field__label" for="ResetPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="ResetPassword" class="field__input" autocomplete="new-password" required>
      </div>

      <div class="field field--password">
        <label class="field__label" for="ResetPasswordConfirm">Confirm password</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" class="field__input" autocomplete="new-password" required>
      </div>

      {%- liquid
        assign reset_label = section.settings.submit_label | default: 'Reset password'
      -%}
      {%- render 'button', label: reset_label, style: 'primary', full_width: true, type: 'submit' -%}
    {%- endform -%}

    <p class="auth__footer">
      <a href="{{ routes.account_login_url }}">{{ 'account.login' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": [
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Enter a new password for your account."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Reset password"
    }
  ]
}
{% endschema %}
