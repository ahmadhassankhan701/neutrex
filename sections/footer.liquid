{%- liquid
  assign newsletter_block = false
  assign contact_block = false
  for block in section.blocks
    if block.type == 'newsletter'
      assign newsletter_block = block
    elsif block.type == 'contact'
      assign contact_block = block
    endif
  endfor
-%}

<footer class="site-footer" role="contentinfo" {{ section.shopify_attributes }}>
  {%- if newsletter_block -%}
    <div class="site-footer__newsletter-band" {{ newsletter_block.shopify_attributes }}>
      <div class="page-width site-footer__newsletter-band-inner">
        <div class="site-footer__newsletter-copy">
          {%- if newsletter_block.settings.heading != blank -%}
            <h2 class="site-footer__newsletter-title">{{ newsletter_block.settings.heading | escape }}</h2>
          {%- else -%}
            <h2 class="site-footer__newsletter-title">{{ 'footer.newsletter_heading' | t }}</h2>
          {%- endif -%}

          {%- if newsletter_block.settings.text != blank -%}
            <p class="site-footer__newsletter-text">{{ newsletter_block.settings.text | escape }}</p>
          {%- else -%}
            <p class="site-footer__newsletter-text">{{ 'footer.newsletter_text' | t }}</p>
          {%- endif -%}
        </div>

        {%- form 'customer', class: 'site-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-fields">
            <label class="visually-hidden" for="FooterNewsletter-{{ section.id }}">
              {{ 'footer.newsletter_placeholder' | t }}
            </label>
            <input
              id="FooterNewsletter-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input site-footer__newsletter-input"
              value="{{ form.email }}"
              placeholder="{{ 'footer.newsletter_placeholder' | t }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              aria-required="true"
            >
            <button type="submit" class="btn btn--gold site-footer__newsletter-submit">
              {{ 'footer.newsletter_button' | t }}
            </button>
          </div>
          <label class="site-footer__consent">
            <input type="checkbox" name="contact[accepts_marketing]" value="true" checked>
            <span>
              {%- if newsletter_block.settings.consent_text != blank -%}
                {{ newsletter_block.settings.consent_text | escape }}
              {%- else -%}
                Send me training tips, drops, and exclusive offers
              {%- endif -%}
            </span>
          </label>
          {%- if form.posted_successfully? -%}
            <p class="site-footer__form-success" role="status">{{ 'footer.newsletter_success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="site-footer__form-error" role="alert">{{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name | escape }}">
          {%- if settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: settings.logo_width }}"
              alt="{{ shop.name | escape }}"
              width="{{ settings.logo_width }}"
              loading="lazy"
            >
          {%- else -%}
            {{ settings.brand_name | default: shop.name }}
          {%- endif -%}
        </a>

        {%- if section.settings.brand_text != blank -%}
          <p class="site-footer__tagline">{{ section.settings.brand_text | escape }}</p>
        {%- endif -%}

        {% render 'social-icons' %}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          {%- liquid
            assign footer_menu = block.settings.menu
            if footer_menu != blank and footer_menu.links == blank
              assign footer_menu = linklists[block.settings.menu]
            endif
          -%}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="site-footer__column-title">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
            {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
              <ul class="site-footer__links" role="list">
                {%- for link in footer_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="site-footer__link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if contact_block -%}
        {%- liquid
          assign contact_whatsapp = contact_block.settings.whatsapp_number | default: settings.whatsapp_number
          assign contact_location = contact_block.settings.location | default: settings.business_location
          assign contact_hours = contact_block.settings.hours | default: settings.business_hours
          assign contact_email = contact_block.settings.email
          assign contact_phone = contact_block.settings.phone
          assign wa_digits = contact_whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
        -%}
        <div class="site-footer__column site-footer__contact" {{ contact_block.shopify_attributes }}>
          {%- if contact_block.settings.heading != blank -%}
            <p class="site-footer__column-title">{{ contact_block.settings.heading | escape }}</p>
          {%- else -%}
            <p class="site-footer__column-title">{{ 'footer.contact' | t }}</p>
          {%- endif -%}
          <ul class="site-footer__links site-footer__contact-list" role="list">
            {%- if contact_whatsapp != blank -%}
              <li>
                <a
                  href="https://wa.me/{{ wa_digits }}"
                  class="site-footer__link site-footer__contact-item"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {% render 'icon', icon: 'whatsapp' %}
                  <span>{{ 'footer.whatsapp' | t }}: {{ contact_whatsapp | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if contact_phone != blank -%}
              <li>
                <a
                  href="tel:{{ contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
                  class="site-footer__link site-footer__contact-item"
                >
                  {% render 'icon', icon: 'phone' %}
                  <span>{{ contact_phone | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if contact_email != blank -%}
              <li>
                <a
                  href="mailto:{{ contact_email | escape }}"
                  class="site-footer__link site-footer__contact-item"
                >
                  {% render 'icon', icon: 'mail' %}
                  <span>{{ contact_email | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if contact_location != blank -%}
              <li class="site-footer__contact-item">
                {% render 'icon', icon: 'map-pin' %}
                <span>{{ 'footer.location' | t }}: {{ contact_location | escape }}</span>
              </li>
            {%- endif -%}
            {%- if contact_hours != blank -%}
              <li class="site-footer__contact-item">
                {% render 'icon', icon: 'clock' %}
                <span>{{ 'footer.hours' | t }}: {{ contact_hours | escape }}</span>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        {%- assign copyright_year = 'now' | date: '%Y' -%}
        {{ 'footer.copyright' | t: year: copyright_year, shop_name: shop.name }}
      </p>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="site-footer__payments" aria-label="{{ 'footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <span class="site-footer__payment-icon">{{ type | payment_type_svg_tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_policy_links -%}
        <nav class="site-footer__policies" aria-label="{{ 'footer.policies' | t }}">
          <ul class="site-footer__policy-links" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a href="{{ policy.url }}" class="site-footer__link">{{ policy.title | escape }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand description",
      "default": "Luxury performance fitness. Engineered for athletes who demand excellence."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Join the elite"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "consent_text",
          "label": "Marketing consent text",
          "default": "Send me training tips, drops, and exclusive offers"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "text",
          "id": "whatsapp_number",
          "label": "WhatsApp number",
          "default": "+971500000000",
          "info": "Shown in the footer and used for the WhatsApp link. Leave blank to use Theme settings → Appointments."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number",
          "info": "Optional. Shown as a clickable phone link."
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "info": "Optional. Shown as a clickable email link."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Dubai, UAE",
          "info": "Leave blank to use Theme settings → Appointments."
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Business hours",
          "default": "Sun–Thu · 6:00 AM – 10:00 PM",
          "info": "Leave blank to use Theme settings → Appointments."
        }
      ]
    }
  ]
}
{% endschema %}
