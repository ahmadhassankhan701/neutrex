{{ 'account.css' | asset_url | stylesheet_tag }}

<section class="wishlist-page section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <header class="section__header">
      <h1 class="section__title">{{ 'account.wishlist' | t }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="section__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div data-wishlist-page>
      <div class="wishlist-grid" data-wishlist-grid hidden></div>

      <div class="wishlist-empty" data-wishlist-empty>
        <span class="wishlist-empty__icon" aria-hidden="true">
          {%- render 'icon', icon: 'heart' -%}
        </span>
        {%- liquid
          assign empty_title = section.settings.empty_title | strip
          if empty_title == blank or empty_title == 'Your wishlist is empty'
            assign empty_title = 'account.wishlist_empty_title' | t
          endif
          assign empty_text = section.settings.empty_text | strip
          if empty_text == blank or empty_text == 'Save products you love and come back anytime.'
            assign empty_text = 'account.wishlist_empty_text' | t
          endif
        -%}
        <h2 class="wishlist-empty__title">{{ empty_title | escape }}</h2>
        <p class="wishlist-empty__text">{{ empty_text | escape }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
          {{ 'header.shop_now' | t }}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('[data-wishlist-page]');
    if (!root) return;

    var grid = root.querySelector('[data-wishlist-grid]');
    var empty = root.querySelector('[data-wishlist-empty]');
    var moneyFormat = {{ shop.money_format | json }};

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      try {
        return (Number(cents) / 100).toLocaleString(undefined, {
          style: 'currency',
          currency: {{ cart.currency.iso_code | default: shop.currency | json }}
        });
      } catch (e) {
        return (Number(cents) / 100).toFixed(2);
      }
    }

    function getItems() {
      if (window.NeutrexTheme && NeutrexTheme.Wishlist) {
        return NeutrexTheme.Wishlist.getItems();
      }
      try {
        return JSON.parse(localStorage.getItem('neutrex-wishlist') || '[]');
      } catch (e) {
        return [];
      }
    }

    function renderItem(product, handle) {
      var article = document.createElement('article');
      article.className = 'wishlist-item product-card';
      article.dataset.handle = handle;

      var image = product.featured_image;
      if (!image && product.images && product.images.length) image = product.images[0];
      if (image && image.indexOf('//') === 0) image = 'https:' + image;

      var variant = (product.variants && product.variants[0]) || {};
      var title = product.title || handle;
      var removeLabel = {{ 'products.wishlist_remove' | t | json }};

      article.innerHTML =
        '<button type="button" class="wishlist-item__remove" data-wishlist-toggle data-product-handle="' +
        handle +
        '" data-product-id="' +
        (product.id || '') +
        '" aria-label="' +
        removeLabel +
        '">' +
        '<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>' +
        '</button>' +
        '<a class="product-card__media-link" href="' +
        (product.url || '/products/' + handle) +
        '">' +
        '<div class="product-card__media">' +
        (image
          ? '<img class="product-card__img product-card__img--primary" src="' +
            image +
            '" alt="' +
            title.replace(/"/g, '&quot;') +
            '" loading="lazy" width="720" height="900">'
          : '<div class="product-card__img product-card__img--primary" style="background:var(--color-surface)"></div>') +
        '</div></a>' +
        '<div class="product-card__body">' +
        '<h3 class="product-card__title"><a href="' +
        (product.url || '/products/' + handle) +
        '">' +
        title +
        '</a></h3>' +
        '<div class="product-card__footer"><div class="price"><span class="price__regular">' +
        formatMoney(variant.price || 0) +
        '</span></div></div></div>';

      grid.appendChild(article);
    }

    function load() {
      var items = getItems();
      grid.innerHTML = '';

      if (!items.length) {
        grid.hidden = true;
        empty.hidden = false;
        return;
      }

      empty.hidden = true;
      grid.hidden = false;

      items.forEach(function (entry) {
        var handle = entry.handle || entry.id;
        if (!handle || typeof handle !== 'string') return;

        fetch(((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'products/' + encodeURIComponent(handle) + '.js')
          .then(function (res) {
            return res.ok ? res.json() : null;
          })
          .then(function (product) {
            if (product) renderItem(product, handle);
          })
          .catch(function () {});
      });
    }

    load();
    document.addEventListener('neutrex:wishlist:updated', load);
  });
</script>

<style>
  .wishlist-page .section__header {
    margin-bottom: var(--space-7);
  }
  .wishlist-empty {
    max-width: 28rem;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-8) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-bg-elevated);
  }
  .wishlist-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .wishlist-empty__icon .icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .wishlist-empty__title {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-2);
  }
  .wishlist-empty__text {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
  .wishlist-item .product-card__media {
    aspect-ratio: 4 / 5;
  }
  .wishlist-item .product-card__media-link {
    display: block;
  }
</style>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section-main-wishlist",
  "settings": [
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Products you save appear here."
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty title",
      "default": "Your wishlist is empty"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Save products you love and come back anytime."
    }
  ]
}
{% endschema %}
