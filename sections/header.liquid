{%- liquid
  assign menu_handle = section.settings.menu | default: settings.menu
  assign main_menu = linklists[menu_handle]
  assign logo_width = settings.logo_width | default: 140
  assign is_transparent = false
  if settings.header_transparent and template.name == 'index'
    assign is_transparent = true
  endif
  assign show_wishlist = settings.enable_wishlist
-%}

<header
  class="site-header{% if is_transparent %} site-header--transparent{% endif %}{% unless settings.header_sticky %} site-header--static{% endif %}"
  data-site-header
  role="banner"
  {{ section.shopify_attributes }}
>
  <div class="site-header__inner">
    <button
      type="button"
      class="site-header__icon-btn site-header__menu-toggle"
      data-mobile-nav-open
      aria-expanded="false"
      aria-controls="mobile-nav-{{ section.id }}"
      aria-label="{{ 'general.accessibility.menu' | t }}"
    >
      {% render 'icon', icon: 'menu', size: 22 %}
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: logo_width
          | image_tag:
            class: 'site-header__logo-img site-header__logo-img--light',
            width: logo_width,
            height: 'auto',
            alt: shop.name,
            loading: 'eager'
        }}
      {%- endif -%}
      {%- if settings.logo_dark != blank -%}
        {{
          settings.logo_dark
          | image_url: width: logo_width
          | image_tag:
            class: 'site-header__logo-img site-header__logo-img--dark',
            width: logo_width,
            height: 'auto',
            alt: shop.name,
            loading: 'eager'
        }}
      {%- elsif settings.logo == blank -%}
        <span>{{ settings.brand_name | default: shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if main_menu.links.size > 0 -%}
      <nav class="site-nav" aria-label="{{ 'header.menu' | t }}" data-mega-menu>
        <ul class="site-nav__list" role="list">
          {%- for link in main_menu.links -%}
            {%- liquid
              assign has_children = false
              assign has_grandchildren = false
              assign mega_block = nil

              if link.links.size > 0
                assign has_children = true
                for child in link.links
                  if child.links.size > 0
                    assign has_grandchildren = true
                    break
                  endif
                endfor
              endif

              for block in section.blocks
                if block.type == 'mega_menu' and block.settings.title != blank
                  assign block_title = block.settings.title | downcase | strip
                  assign link_title = link.title | downcase | strip
                  if block_title == link_title
                    assign mega_block = block
                    break
                  endif
                endif
              endfor

              assign show_mega = false
              if settings.enable_mega_menu and has_children
                if has_grandchildren or mega_block
                  assign show_mega = true
                endif
              endif
            -%}

            <li
              class="site-nav__item{% if show_mega %} site-nav__item--mega{% endif %}"
              {% if show_mega %}data-mega-menu-item{% endif %}
            >
              {%- if show_mega -%}
                <button
                  type="button"
                  class="site-nav__link"
                  data-mega-menu-trigger
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {{ link.title | escape }}
                  {% render 'icon', icon: 'chevron-down', size: 14, class: 'site-nav__chevron' %}
                </button>

                <div class="mega-menu" data-mega-menu-panel aria-hidden="true">
                  <div class="mega-menu__grid">
                    {%- if mega_block and mega_block.settings.image != blank -%}
                      <a
                        href="{{ mega_block.settings.featured_link | default: link.url }}"
                        class="mega-menu__featured"
                        {{ mega_block.shopify_attributes }}
                      >
                        {% render 'media',
                          image: mega_block.settings.image,
                          class: 'mega-menu__featured-image',
                          sizes: '(min-width: 990px) 240px, 50vw'
                        %}
                        <div class="mega-menu__featured-overlay">
                          <p class="mega-menu__featured-title">{{ mega_block.settings.featured_title | default: link.title | escape }}</p>
                          <span class="btn btn--sm btn--outline-white">{{ 'header.shop_now' | t }}</span>
                        </div>
                      </a>
                    {%- endif -%}

                    {%- for child in link.links -%}
                      <div class="mega-menu__column">
                        <p class="mega-menu__column-title">
                          {%- if child.url != blank -%}
                            <a href="{{ child.url }}">{{ child.title | escape }}</a>
                          {%- else -%}
                            {{ child.title | escape }}
                          {%- endif -%}
                        </p>
                        {%- if child.links.size > 0 -%}
                          <ul class="mega-menu__links" role="list">
                            {%- for grandchild in child.links -%}
                              <li>
                                <a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- elsif has_children -%}
                <details class="site-nav__details">
                  <summary class="site-nav__link">
                    {{ link.title | escape }}
                    {% render 'icon', icon: 'chevron-down', size: 14, class: 'site-nav__chevron' %}
                  </summary>
                  <ul class="site-nav__dropdown" role="list">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}" class="mega-menu__link">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="site-nav__link"{% if link.current %} aria-current="page"{% endif %}>
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="site-header__actions">
      {%- if section.settings.show_book_cta -%}
        <a
          href="{{ section.settings.book_cta_link | default: settings.booking_form_url | default: '/pages/personal-training' }}"
          class="btn btn--primary btn--sm site-header__cta hide-mobile"
        >
          {{ section.settings.book_cta_label | default: 'header.book_training' | t }}
        </a>
      {%- endif -%}

      <button
        type="button"
        class="site-header__icon-btn"
        data-predictive-search-open
        aria-label="{{ 'general.accessibility.search' | t }}"
      >
        {% render 'icon', icon: 'search', size: 20 %}
      </button>

      <a
        href="{{ routes.account_url }}"
        class="site-header__icon-btn hide-mobile"
        aria-label="{{ 'header.account' | t }}"
      >
        {% render 'icon', icon: 'account', size: 20 %}
      </a>

      {%- if show_wishlist -%}
        <a
          href="/pages/wishlist"
          class="site-header__icon-btn hide-mobile"
          aria-label="{{ 'header.wishlist' | t }}"
        >
          {% render 'icon', icon: 'heart', size: 20 %}
        </a>
      {%- endif -%}

      <div class="hide-mobile">
        {% render 'theme-switcher' %}
      </div>

      <div class="hide-mobile">
        {% render 'locale-selectors' %}
      </div>

      <button
        type="button"
        class="site-header__icon-btn"
        data-cart-open
        aria-label="{{ 'header.cart' | t }}"
      >
        {% render 'icon', icon: 'cart', size: 20 %}
        {% render 'cart-count' %}
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<div
  id="mobile-nav-{{ section.id }}"
  class="mobile-nav"
  data-mobile-nav
  aria-hidden="true"
  aria-label="{{ 'header.menu' | t }}"
>
  <div class="mobile-nav__overlay" data-mobile-nav-close tabindex="-1" aria-hidden="true"></div>

  <div class="mobile-nav__panel" data-mobile-nav-panel role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}">
    <div class="mobile-nav__header">
      <span class="mobile-nav__title">{{ 'header.menu' | t }}</span>
      <button
        type="button"
        class="site-header__icon-btn"
        data-mobile-nav-close
        aria-label="{{ 'general.accessibility.close' | t }}"
      >
        {% render 'icon', icon: 'close', size: 22 %}
      </button>
    </div>

    <div class="mobile-nav__body">
      {%- if main_menu.links.size > 0 -%}
        <ul class="mobile-nav__list" role="list">
          {%- for link in main_menu.links -%}
            <li class="mobile-nav__item" data-mobile-nav-item>
              {%- if link.links.size > 0 -%}
                <button
                  type="button"
                  class="mobile-nav__link mobile-nav__link--toggle"
                  data-mobile-nav-submenu-toggle
                  aria-expanded="false"
                >
                  <span>{{ link.title | escape }}</span>
                  {% render 'icon', icon: 'chevron-down', size: 18 %}
                </button>
                <ul class="mobile-nav__sublist" data-mobile-nav-submenu role="list">
                  <li>
                    <a href="{{ link.url }}" class="mobile-nav__sublink mobile-nav__sublink--all">{{ link.title | escape }}</a>
                  </li>
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title | escape }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul class="mobile-nav__sublist mobile-nav__sublist--nested" role="list">
                          {%- for grandchild in child.links -%}
                            <li>
                              <a href="{{ grandchild.url }}" class="mobile-nav__sublink">{{ grandchild.title | escape }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <a href="{{ link.url }}" class="mobile-nav__link"{% if link.current %} aria-current="page"{% endif %}>
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="mobile-nav__footer">
      <div class="mobile-nav__footer-links">
        <a href="{{ routes.account_url }}" class="mobile-nav__footer-link">
          {% render 'icon', icon: 'account', size: 18 %}
          {{ 'header.account' | t }}
        </a>
        {%- if show_wishlist -%}
          <a href="/pages/wishlist" class="mobile-nav__footer-link">
            {% render 'icon', icon: 'heart', size: 18 %}
            {{ 'header.wishlist' | t }}
          </a>
        {%- endif -%}
      </div>

      <div class="mobile-nav__switchers">
        {% render 'theme-switcher' %}
        {% render 'locale-selectors' %}
      </div>

      {%- if section.settings.show_book_cta -%}
        <a
          href="{{ section.settings.book_cta_link | default: settings.booking_form_url | default: '/pages/personal-training' }}"
          class="btn btn--primary btn--full"
        >
          {{ section.settings.book_cta_label | default: 'header.book_training' | t }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .site-header__logo-img--dark { display: none; }
  [data-theme="dark"] .site-header__logo-img--light { display: none; }
  [data-theme="dark"] .site-header__logo-img--dark { display: inline-block; }
  .site-header__cta.hide-mobile { display: none; }
  @media (min-width: 990px) {
    .site-header__cta.hide-mobile { display: inline-flex; }
  }
  .hide-mobile { display: none; }
  @media (min-width: 990px) {
    .hide-mobile { display: inline-flex; }
    .hide-mobile.switcher,
    .hide-mobile .theme-switch { display: inline-flex; }
  }
  .mobile-nav__link--toggle {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
  }
  .mobile-nav__sublist:not(.is-open) { display: none; }
  .mobile-nav__sublist.is-open { display: block; }
  .mobile-nav__sublist--nested {
    padding-inline-start: var(--space-4);
    margin-block-start: var(--space-2);
  }
  .mobile-nav__sublink--all { font-weight: 700; color: var(--color-primary); }
  .mobile-nav__footer-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .mobile-nav__footer-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .mobile-nav__switchers {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .mobile-nav__title {
    font-size: var(--fs-md);
    font-weight: 700;
  }
  .site-nav__details { position: relative; }
  .site-nav__details > summary { list-style: none; cursor: pointer; }
  .site-nav__details > summary::-webkit-details-marker { display: none; }
  .site-nav__dropdown {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 0;
    min-width: 12rem;
    padding: var(--space-3);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 5;
  }
{% endstylesheet %}

<script>
  (function () {
    var header = document.querySelector('[data-site-header]');
    if (!header) return;

    var onScroll = function () {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Overrides theme settings menu when set"
    },
    {
      "type": "header",
      "content": "Book training CTA"
    },
    {
      "type": "checkbox",
      "id": "show_book_cta",
      "label": "Show book training button",
      "default": true
    },
    {
      "type": "text",
      "id": "book_cta_label",
      "label": "Button label",
      "default": "Book Training"
    },
    {
      "type": "url",
      "id": "book_cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Menu item title",
          "info": "Must match the top-level navigation link title exactly"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image"
        },
        {
          "type": "text",
          "id": "featured_title",
          "label": "Featured title"
        },
        {
          "type": "url",
          "id": "featured_link",
          "label": "Featured link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
