<section class="main-blog section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <header class="section__header">
      <h1 class="section__title">{{ blog.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="section__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <div class="grid grid--3" style="gap: var(--space-6);">
        {%- for article in blog.articles -%}
          <article class="card" data-animate style="display:flex;flex-direction:column;">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="card__media" style="aspect-ratio: 16/10; overflow: hidden;">
                {%- render 'media',
                  image: article.image,
                  widths: '400,600,800',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  class: 'card__image',
                  loading: 'lazy',
                  alt: article.image.alt | default: article.title
                -%}
              </a>
            {%- endif -%}
            <div style="padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); flex: 1;">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" style="font-size: var(--fs-xs); color: var(--color-text-muted);">
                {{ article.published_at | date: format: 'date' }}
              </time>
              <h2 style="font-size: var(--fs-xl);">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h2>
              {%- if article.excerpt != blank -%}
                <p style="color: var(--color-text-muted); font-size: var(--fs-sm);">{{ article.excerpt | strip_html | truncate: 140 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="btn btn--ghost btn--sm" style="align-self: flex-start; margin-top: auto;">
                Read more
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Training insights, nutrition science, and athlete stories."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 9
    }
  ]
}
{% endschema %}
