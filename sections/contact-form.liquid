{%- liquid
  assign title_raw = section.settings.title | strip
  if title_raw == blank or title_raw == 'footer.contact'
    assign page_title = 'footer.contact' | t
  else
    assign page_title = title_raw
  endif

  assign contact_whatsapp = section.settings.whatsapp_number | default: settings.whatsapp_number | strip
  assign contact_location = section.settings.location | default: settings.business_location | strip
  assign contact_hours = section.settings.hours | default: settings.business_hours | strip
  assign contact_email = section.settings.email | strip
  assign contact_phone = section.settings.phone | strip
  assign wa_digits = contact_whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
-%}

<section class="section contact-page" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="contact-page__layout">
      <div class="contact-page__form-col">
        <header class="section-header contact-page__header">
          <h1 class="section-header__title">{{ page_title | escape }}</h1>
          {%- if section.settings.subtitle != blank -%}
            <p class="section-header__subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        </header>

        {%- form 'contact', class: 'auth__form contact-page__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="auth__success" role="status">
              {{ section.settings.success_message | default: 'Thanks for reaching out. We will reply shortly.' | escape }}
            </div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="auth__error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="contact-page__fields-row">
            <div class="field">
              <label class="field__label" for="ContactName-{{ section.id }}">{{ 'customer.register.first_name' | t }}</label>
              <input
                type="text"
                id="ContactName-{{ section.id }}"
                name="contact[name]"
                class="field__input"
                autocomplete="name"
                required
                value="{% if form.name %}{{ form.name | escape }}{% endif %}"
              >
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail-{{ section.id }}">{{ 'customer.login.email' | t }}</label>
              <input
                type="email"
                id="ContactEmail-{{ section.id }}"
                name="contact[email]"
                class="field__input"
                autocomplete="email"
                required
                value="{% if form.email %}{{ form.email | escape }}{% endif %}"
              >
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
            <input
              type="tel"
              id="ContactPhone-{{ section.id }}"
              name="contact[phone]"
              class="field__input"
              autocomplete="tel"
            >
          </div>

          <div class="field">
            <label class="field__label" for="ContactSubject-{{ section.id }}">{{ 'contact.subject' | t }}</label>
            <input
              type="text"
              id="ContactSubject-{{ section.id }}"
              name="contact[subject]"
              class="field__input"
              placeholder="{{ 'contact.subject_placeholder' | t }}"
            >
          </div>

          <div class="field">
            <label class="field__label" for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }}</label>
            <textarea
              id="ContactMessage-{{ section.id }}"
              name="contact[body]"
              class="field__textarea"
              rows="6"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          {%- liquid
            assign send_label = section.settings.button_label | strip
            if send_label == blank
              assign send_label = 'contact.send' | t
            endif
          -%}
          {%- render 'button', label: send_label, style: 'primary', full_width: true, type: 'submit' -%}
        {%- endform -%}
      </div>

      <aside class="contact-page__info-col">
        <div class="contact-page__card">
          <h2 class="contact-page__card-title">
            {{ section.settings.info_heading | default: 'Visit Neutrex' | escape }}
          </h2>

          <ul class="contact-page__details" role="list">
            {%- if contact_whatsapp != blank -%}
              <li>
                <a
                  class="contact-page__detail contact-page__detail--link"
                  href="https://wa.me/{{ wa_digits }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="contact-page__detail-icon" aria-hidden="true">
                    {% render 'icon', icon: 'whatsapp', size: 18 %}
                  </span>
                  <span class="contact-page__detail-body">
                    <span class="contact-page__detail-label">{{ 'footer.whatsapp' | t }}</span>
                    <span class="contact-page__detail-value">{{ contact_whatsapp | escape }}</span>
                  </span>
                </a>
              </li>
            {%- endif -%}

            {%- if contact_phone != blank -%}
              <li>
                <a
                  class="contact-page__detail contact-page__detail--link"
                  href="tel:{{ contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
                >
                  <span class="contact-page__detail-icon" aria-hidden="true">
                    {% render 'icon', icon: 'phone', size: 18 %}
                  </span>
                  <span class="contact-page__detail-body">
                    <span class="contact-page__detail-label">{{ 'contact.phone' | t }}</span>
                    <span class="contact-page__detail-value">{{ contact_phone | escape }}</span>
                  </span>
                </a>
              </li>
            {%- endif -%}

            {%- if contact_email != blank -%}
              <li>
                <a
                  class="contact-page__detail contact-page__detail--link"
                  href="mailto:{{ contact_email | escape }}"
                >
                  <span class="contact-page__detail-icon" aria-hidden="true">
                    {% render 'icon', icon: 'mail', size: 18 %}
                  </span>
                  <span class="contact-page__detail-body">
                    <span class="contact-page__detail-label">{{ 'customer.login.email' | t }}</span>
                    <span class="contact-page__detail-value">{{ contact_email | escape }}</span>
                  </span>
                </a>
              </li>
            {%- endif -%}

            {%- if contact_location != blank -%}
              <li class="contact-page__detail">
                <span class="contact-page__detail-icon" aria-hidden="true">
                  {% render 'icon', icon: 'map-pin', size: 18 %}
                </span>
                <span class="contact-page__detail-body">
                  <span class="contact-page__detail-label">{{ 'footer.location' | t }}</span>
                  <span class="contact-page__detail-value">{{ contact_location | escape }}</span>
                </span>
              </li>
            {%- endif -%}

            {%- if contact_hours != blank -%}
              <li class="contact-page__detail">
                <span class="contact-page__detail-icon" aria-hidden="true">
                  {% render 'icon', icon: 'clock', size: 18 %}
                </span>
                <span class="contact-page__detail-body">
                  <span class="contact-page__detail-label">{{ 'footer.hours' | t }}</span>
                  <span class="contact-page__detail-value">{{ contact_hours | escape }}</span>
                </span>
              </li>
            {%- endif -%}
          </ul>

          {%- if contact_whatsapp != blank -%}
            <a
              class="btn btn--primary btn--full contact-page__whatsapp-btn"
              href="https://wa.me/{{ wa_digits }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {% render 'icon', icon: 'whatsapp', size: 18 %}
              <span>{{ 'footer.whatsapp' | t }}: {{ contact_whatsapp | escape }}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.map_embed != blank -%}
            <div class="contact-page__map rte">{{ section.settings.map_embed }}</div>
          {%- elsif section.settings.show_map_placeholder -%}
            <div class="contact-page__map-placeholder">
              {% render 'icon', icon: 'map-pin', size: 24 %}
              <span>{{ 'contact.map_placeholder' | t }}</span>
            </div>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact-page {
    padding-block: var(--space-8) var(--space-10);
  }

  .contact-page__layout {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 990px) {
    .contact-page__layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }

  .contact-page__header {
    margin-bottom: var(--space-8);
  }

  .contact-page__header .section-header__subtitle {
    margin-top: var(--space-3);
    max-width: 36rem;
  }

  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-page__form .field {
    gap: var(--space-3);
  }

  .contact-page__form .field__label {
    margin-bottom: 0;
  }

  .contact-page__fields-row {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 750px) {
    .contact-page__fields-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }

  .contact-page__form .btn {
    margin-top: var(--space-2);
  }

  .contact-page__card {
    padding: var(--space-7) var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 750px) {
    .contact-page__card {
      padding: var(--space-8);
    }
  }

  .contact-page__card-title {
    font-size: var(--fs-xl);
    font-weight: 700;
    margin: 0 0 var(--space-6);
  }

  .contact-page__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    list-style: none;
    margin: 0 0 var(--space-7);
    padding: 0;
  }

  .contact-page__detail,
  .contact-page__detail--link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    color: inherit;
    text-decoration: none;
  }

  .contact-page__detail--link:hover .contact-page__detail-value {
    color: var(--color-primary);
  }

  .contact-page__detail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .contact-page__detail-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding-block: 0.15rem;
  }

  .contact-page__detail-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-page__detail-value {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text);
    word-break: break-word;
  }

  .contact-page__whatsapp-btn {
    margin-bottom: var(--space-6);
  }

  .contact-page__map {
    margin-top: var(--space-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .contact-page__map iframe {
    display: block;
    width: 100%;
    min-height: 16rem;
    border: 0;
  }

  .contact-page__map-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 14rem;
    margin-top: var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Questions about training, products, or partnerships? We're here to help."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for reaching out. We will reply shortly."
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info sidebar heading",
      "default": "Visit Neutrex"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "+971500000000",
      "info": "Include country code. Leave blank to use Theme settings → Appointments."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "textarea",
      "id": "location",
      "label": "Location",
      "default": "Dubai, UAE"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Business hours",
      "default": "Sun–Thu · 6:00 AM – 10:00 PM"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Map embed HTML"
    },
    {
      "type": "checkbox",
      "id": "show_map_placeholder",
      "label": "Show map placeholder when embed empty",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
