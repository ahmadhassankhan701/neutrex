{%- liquid
  assign section_class = 'section featured-categories'
  if section.settings.background_style == 'surface'
    assign section_class = section_class | append: ' section--surface'
  elsif section.settings.background_style == 'gradient'
    assign section_class = section_class | append: ' section--gradient'
  endif
  assign grid_class = 'featured-categories__grid'
  if section.settings.hero_first_card
    assign grid_class = grid_class | append: ' featured-categories__grid--hero'
  endif
-%}

<section
  class="{{ section_class }}"
  aria-labelledby="FeaturedCategories-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <header class="section__header animate-fade-up" data-animate id="FeaturedCategories-{{ section.id }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="section__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="{{ grid_class }} animate-stagger" data-animate>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign card_class = 'category-card'
            if section.settings.hero_first_card and forloop.first
              assign card_class = card_class | append: ' category-card--hero'
            endif
          -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="{{ card_class }}"
            {{ block.shopify_attributes }}
          >
            <div class="category-card__media">
              {%- if block.settings.image != blank -%}
                {%- render 'media',
                  image: block.settings.image,
                  alt: block.settings.title,
                  loading: 'lazy',
                  widths: '400,600,800,1000,1200',
                  sizes: '(min-width: 990px) 25vw, 50vw'
                -%}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
              <div class="category-card__overlay"></div>
            </div>
            <div class="category-card__content">
              <div class="category-card__glass">
                {%- if block.settings.product_count != blank -%}
                  <p class="category-card__count">{{ block.settings.product_count | escape }}</p>
                {%- endif -%}
                <h3 class="category-card__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.description != blank -%}
                  <p class="category-card__description">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                <span class="category-card__link">
                  {{ block.settings.link_label | default: 'Shop now' | escape }}
                  {%- render 'icon', icon: 'chevron-right', size: 'sm' -%}
                </span>
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .category-card__description {
    font-size: var(--fs-xs);
    opacity: 0.75;
    margin-bottom: var(--space-2);
    line-height: var(--lh-snug);
  }
</style>

{% schema %}
{
  "name": "Featured categories",
  "tag": "section",
  "class": "section-featured-categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Performance gear engineered for results"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Surface" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "hero_first_card",
      "label": "Hero layout for first card",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count label",
          "info": "Optional, e.g. \"48 products\""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Training",
            "description": "Personal training, online coaching, and elite programming",
            "product_count": "12 services",
            "link": "/pages/personal-training"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Supplements",
            "description": "Protein, creatine, pre-workout, and recovery",
            "product_count": "64 products",
            "link": "/collections/supplements"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Clothing",
            "description": "Compression wear, hoodies, and performance layers",
            "product_count": "86 products",
            "link": "/collections/clothing"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Accessories",
            "description": "Shakers, straps, belts, and training essentials",
            "product_count": "32 products",
            "link": "/collections/accessories"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Nutrition",
            "description": "Meal plans and macro-optimized nutrition programs",
            "product_count": "18 plans",
            "link": "/collections/nutrition-plans"
          }
        }
      ]
    }
  ]
}
{% endschema %}
