<section class="main-article section" {{ section.shopify_attributes }}>
  <article class="page-width" itemscope itemtype="https://schema.org/Article">
    <header class="main-article__header" style="max-width: 48rem; margin-inline: auto; text-align: center; margin-bottom: var(--space-7);">
      {%- render 'breadcrumb' -%}
      {%- if article.tags.size > 0 -%}
        <p class="section__eyebrow">{{ article.tags.first }}</p>
      {%- endif -%}
      <h1 class="main-article__title" itemprop="headline">{{ article.title | escape }}</h1>
      <p style="color: var(--color-text-muted); font-size: var(--fs-sm); margin-top: var(--space-3);">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
          {{ article.published_at | date: format: 'date' }}
        </time>
        {%- if article.author != blank -%}
          <span aria-hidden="true"> · </span>
          <span itemprop="author">{{ article.author }}</span>
        {%- endif -%}
      </p>
    </header>

    {%- if article.image and section.settings.show_featured_image -%}
      <div class="main-article__media" style="margin-bottom: var(--space-7); border-radius: var(--radius-2xl); overflow: hidden;">
        {%- render 'media',
          image: article.image,
          widths: '800,1200,1600,2000',
          sizes: 'min(100vw, 87.5rem)',
          class: 'main-article__image',
          loading: 'eager',
          alt: article.image.alt | default: article.title
        -%}
      </div>
    {%- endif -%}

    <div
      class="main-article__content rte"
      itemprop="articleBody"
      style="max-width: 42rem; margin-inline: auto; color: var(--color-text); line-height: var(--lh-normal);"
    >
      {{ article.content }}
    </div>

    {%- if section.settings.show_share -%}
      <div style="max-width: 42rem; margin: var(--space-7) auto 0; display: flex; justify-content: center;">
        {%- render 'share-buttons', url: article.url, title: article.title -%}
      </div>
    {%- endif -%}
  </article>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | default: shop.name | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
    {%- if article.image -%}
    ,"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
    {%- endif -%}
  }
</script>

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": true
    }
  ]
}
{% endschema %}
