{%- liquid
  assign section_class = 'newsletter-band section--flush'
  if section.settings.layout == 'split'
    assign section_class = section_class | append: ' newsletter-band--split'
  endif
-%}

<section
  class="{{ section_class }}"
  aria-labelledby="Newsletter-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="newsletter-band__glow" aria-hidden="true"></div>

  <div class="page-width">
    <div class="newsletter-band__inner animate-fade-up" data-animate>
      <div class="newsletter-band__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter-band__title" id="Newsletter-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="newsletter-band__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="newsletter-band__form-wrap">
        {%- assign newsletter_form_id = 'NewsletterForm-' | append: section.id -%}
        {%- form 'customer', class: 'newsletter-band__form', id: newsletter_form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div class="newsletter-band__success" role="status">
              {%- render 'icon', icon: 'check' -%}
              {{ section.settings.success_message | default: 'newsletter.success' | t }}
            </div>
          {%- else -%}
            <div class="newsletter-band__input-wrap">
              <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
                {{ section.settings.placeholder | default: 'footer.newsletter_placeholder' | t }}
              </label>
              <input
                id="NewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="newsletter-band__input"
                value="{{ form.email }}"
                placeholder="{{ section.settings.placeholder | default: 'footer.newsletter_placeholder' | t }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                aria-required="true"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="NewsletterError-{{ section.id }}"
                {% endif %}
              >
            </div>
            <div class="newsletter-band__submit">
              {%- render 'button',
                label: section.settings.button_label | default: 'footer.newsletter_button' | t,
                type: 'submit',
                style: 'gold',
                class: 'btn-ripple'
              -%}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <p id="NewsletterError-{{ section.id }}" class="newsletter-band__error" role="alert">
              {{ 'newsletter.error' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.disclaimer != blank -%}
          <p class="newsletter-band__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank and section.settings.layout == 'split' -%}
        <div class="newsletter-band__media image-reveal" data-animate aria-hidden="true">
          {%- render 'media',
            image: section.settings.image,
            alt: '',
            loading: 'lazy',
            widths: '400,600,800',
            sizes: '(min-width: 990px) 30vw, 0px'
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .newsletter-band--split .newsletter-band__inner {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .newsletter-band__media {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    display: none;
  }
  @media (min-width: 990px) {
    .newsletter-band--split .newsletter-band__media {
      display: block;
    }
  }
  .newsletter-band__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  .newsletter-band .section__eyebrow {
    color: var(--color-gold);
  }
  .newsletter-band__error {
    font-size: var(--fs-xs);
    color: var(--color-error);
    margin-top: var(--space-2);
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inner circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the elite"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Training tips, product drops, and exclusive member offers — delivered to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for joining Neutrex."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>By subscribing you agree to receive marketing emails. Unsubscribe anytime.</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "split", "label": "With image side" }
      ],
      "default": "default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image",
      "info": "Shown when split layout is selected"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
